# Copy to .env.local (web) / .env (scripts) and fill in real values.
# NEVER commit an actual .env file — .gitignore already excludes them.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never exposed to any client bundle
DATABASE_URL=                         # postgres connection string, used by scripts/db-*.sh in CI/local dev only

# --- Supabase (apps/mobile — Expo inlines EXPO_PUBLIC_* into the client bundle
# at build time, same anon-key-is-safe-to-ship reasoning as NEXT_PUBLIC_*
# above; same project, so same values, just re-prefixed for Expo's convention) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_URL=https://ngc.co.tz # web app base URL — mobile links out to it for flows that need a Supabase service-role client (e.g. applicant status lookup), which mobile itself must never hold (see apps/mobile/app/(app)/application-status.tsx)

# --- Notifications (channels are independently toggleable; leave blank to disable) ---
EMAIL_PROVIDER=                       # e.g. "resend" | "sendgrid" | "smtp"
EMAIL_API_KEY=
SMS_PROVIDER=                         # Tanzania-capable aggregator, selected per PRD.md S14.7
SMS_API_KEY=
WHATSAPP_PROVIDER=                    # must be an approved WhatsApp Business Platform/BSP integration
WHATSAPP_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=

# --- AI/LLM (advisory-only features per ARCHITECTURE.md S14) ---
AI_PROVIDER=
AI_API_KEY=

# --- Error tracking / monitoring ---
ERROR_TRACKING_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=https://ngc.co.tz
